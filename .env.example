# Copy to .env.local and fill in. Never put real values in this file (it is committed). See README §8.

# --- Day 1 (required to run anything) ---
# mongodb+srv://USER:PASS@cluster0.xxxx.mongodb.net/doctraders_dev?retryWrites=true&w=majority
MONGODB_URI=
# openssl rand -base64 32 (different value in local and production)
JWT_SECRET=
APP_URL=http://localhost:3000

SEED_SUPERADMIN_NAME=
SEED_SUPERADMIN_EMAIL=
# 10-digit mobile, e.g. 9876543210
SEED_SUPERADMIN_MOBILE=
# Minimum 8 characters. Change it after the first login.
SEED_SUPERADMIN_PASSWORD=

# --- Day 2 (email + images) ---
RESEND_API_KEY=
EMAIL_FROM="Doctraders <no-reply@yourdomain.com>"
ADMIN_NOTIFY_EMAILS=

BLOB_READ_WRITE_TOKEN=
